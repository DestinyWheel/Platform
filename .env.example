# 复制成 .env 再改（.env 已被 gitignore）。
# 所有变量都有默认值，本地开发什么都不设也能跑。

# ---------- 数据库 ----------
# 不设：用嵌入式 PGlite，数据落在 .data/pg，零依赖
# 设置：连真正的 Postgres，SQL 和迁移完全一致
# DATABASE_URL=postgres://user:pass@localhost:5432/platform
# PGDATA=.data/pg

# ---------- 服务 ----------
# PORT=8787
# HOST=127.0.0.1
# LOG_LEVEL=info

# ---------- 账号 ----------
# 上线必须改。改了等于让所有已签发的令牌立即失效
# JWT_SECRET=please-change-me-to-a-long-random-string

# 设了就变成"凭邀请码注册"；不设是开放注册
# REGISTER_CODE=

# 0 = 关闭旧账号的自助认领（把在意的账号都设上密码之后再关）
# AUTH_ALLOW_CLAIM=1

# ---------- 插件 ----------
# 插件产物目录
# PLUGIN_DIR=storage/plugins

# 0 = 启动时不自动发布 games/ 下的源码
# AUTO_PUBLISH_GAMES=1

# ---------- 前端 ----------
# 前端构建产物目录；存在就由服务进程直接托管，不存在只提供 API
# WEB_DIR=apps/web/dist

# ---------- 运维 ----------
# 备份保留份数（超出删最旧的）
# BACKUP_KEEP=14
